# LiveKit (https://cloud.livekit.io or self-hosted)
# Put this file at the monorepo root as `.env`. No spaces around `=`.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Web app (Vite) — only needed for local development.
# In Docker deployment, this is set automatically to /api.
# Leave blank to auto-detect (localhost → :8787, production → /api).
VITE_SIGNALING_URL=

# Signaling server (optional)
# SIGNALING_PORT=8787
# SIGNALING_HOST=0.0.0.0
# CORS_ORIGIN=*
